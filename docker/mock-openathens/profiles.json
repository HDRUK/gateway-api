{
  "valid": {
    "label": "Valid institutional user",
    "claims": {
      "eduPersonTargetedID": "OA-TARGETED-ID-0001",
      "eduPersonScopedAffiliation": "member@example.ac.uk",
      "derivedEduPersonAffiliation": "member",
      "derivedEduPersonScope": "example.ac.uk"
    }
  },
  "valid-list": {
    "label": "Valid, claims wrapped in single-element lists",
    "claims": {
      "eduPersonTargetedID": ["OA-TARGETED-ID-0001"],
      "eduPersonScopedAffiliation": ["member@example.ac.uk"]
    }
  },
  "pairwise-only": {
    "label": "No targeted id, pairwiseID fallback",
    "claims": {
      "pairwiseID": "OA-PAIRWISE-0002@example.ac.uk",
      "eduPersonScopedAffiliation": "member@example.ac.uk"
    }
  },
  "second-user": {
    "label": "A different institutional user",
    "claims": {
      "eduPersonTargetedID": "OA-TARGETED-ID-0009",
      "eduPersonScopedAffiliation": "staff@example.ac.uk"
    }
  },
  "missing-id": {
    "label": "No persistent identifier at all",
    "claims": {
      "sub": "non-persistent-sub-only",
      "eduPersonScopedAffiliation": "member@example.ac.uk"
    }
  },
  "null-id": {
    "label": "eduPersonTargetedID is null",
    "claims": {
      "eduPersonTargetedID": null,
      "eduPersonScopedAffiliation": "member@example.ac.uk"
    }
  },
  "list-holding-null": {
    "label": "eduPersonTargetedID is [null]",
    "claims": {
      "eduPersonTargetedID": [null],
      "eduPersonScopedAffiliation": "member@example.ac.uk"
    }
  },
  "empty-list": {
    "label": "eduPersonTargetedID is []",
    "claims": {
      "eduPersonTargetedID": [],
      "eduPersonScopedAffiliation": "member@example.ac.uk"
    }
  },
  "empty-string": {
    "label": "eduPersonTargetedID is an empty string",
    "claims": {
      "eduPersonTargetedID": "",
      "eduPersonScopedAffiliation": "member@example.ac.uk"
    }
  },
  "blank-string": {
    "label": "eduPersonTargetedID is whitespace",
    "claims": {
      "eduPersonTargetedID": "   ",
      "eduPersonScopedAffiliation": "member@example.ac.uk"
    }
  },
  "two-values": {
    "label": "eduPersonTargetedID holds two values",
    "claims": {
      "eduPersonTargetedID": ["OA-TARGETED-ID-0001", "OA-TARGETED-ID-0002"],
      "eduPersonScopedAffiliation": "member@example.ac.uk"
    }
  },
  "object-id": {
    "label": "eduPersonTargetedID is an object",
    "claims": {
      "eduPersonTargetedID": { "value": "OA-TARGETED-ID-0001" },
      "eduPersonScopedAffiliation": "member@example.ac.uk"
    }
  },
  "no-affiliation": {
    "label": "Valid id, no eduPersonScopedAffiliation",
    "claims": {
      "eduPersonTargetedID": "OA-TARGETED-ID-0003"
    }
  }
}
