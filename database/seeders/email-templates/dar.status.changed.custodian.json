{
    "identifier": "dar.status.changed.custodian",
    "layout": "new",
    "header_text": "Data Access Request message",
    "subject": "Status changed for [[PROJECT_TITLE]] from [[CUSTODIAN_NAME]] - Health Data Research Gateway",
    "body": "\n\n                    <!-- body section start -->\n                    <mj-wrapper background-color=\"#ffffff\" border=\"none\" direction=\"ltr\" text-align=\"center\" padding=\"20px 0\">\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\">\n                                <mj-text padding=\"0px 0px 8px 0px\">Hi [[USER_FIRST_NAME]],</mj-text>\n                                <mj-text padding=\"0px\">The status of your Data Access Request has changed</mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"15px 20px 0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"35%\">\n                                <mj-text padding=\"5px 0px\"><b>Project:</b></mj-text>\n                                <mj-text padding=\"5px 0px\"><b>Dataset:</b></mj-text>\n                                <mj-text padding=\"5px 0px\"><b>Custodian:</b></mj-text>\n                                <mj-text padding=\"5px 0px\"><b>New status:</b></mj-text>\n                            </mj-column>\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"65%\">\n                                <mj-text padding=\"5px 0px\">[[PROJECT_TITLE]]</mj-text>\n                                <mj-text padding=\"5px 0px\">[[DATASET_TITLE]]</mj-text>\n                                <mj-text padding=\"5px 0px\"><a href=\"[[CUSTODIAN_URL]]\" style=\"color:#475DA7;text-decoration:none;\">[[CUSTODIAN_NAME]]</a></mj-text>\n                                <mj-text padding=\"5px 0px\"><span style=\"background-color:#475DA7;color:#ffffff;padding:3px 12px;border-radius:4px;font-size:12px;\">[[DAR_STATUS]]</span></mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"10px 20px 0px 20px\">\n                            <mj-column>\n                                <mj-divider border-color=\"#dee2e6\" border-style=\"dashed\" border-width=\"1px\" padding=\"0\" />\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"10px 20px 0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"35%\">\n                                <mj-text padding=\"0px\"><b>Decision sender</b></mj-text>\n                            </mj-column>\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"65%\">\n                                <mj-text padding=\"0px\">[[DECISION_SENDER_NAME]]</mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"5px 20px 0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"35%\">\n                                <mj-text padding=\"0px\"><b>Comment date:</b></mj-text>\n                            </mj-column>\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"65%\">\n                                <mj-text padding=\"0px\">[[COMMENT_DATE]]</mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"10px 20px 0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\">\n                                <mj-text>[[COMMENT]]</mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"10px 20px 20px 20px\">\n                            <mj-column border=\"1px solid #dee2e6\" border-radius=\"8px\" background-color=\"#f8f9fa\" vertical-align=\"top\" padding=\"20px\">\n                                <mj-text align=\"left\" font-weight=\"700\" font-size=\"14px\" padding=\"0px 0px 10px 0px\">\n                                    View this Data Access Request on the Gateway, to review and change the status.\n                                </mj-text>\n                                <mj-text align=\"left\" font-size=\"13px\" padding=\"0px 0px 15px 0px\">\n                                    Comments, replies and status changes will be sent to this email address.\n                                </mj-text>\n                                <mj-button align=\"left\" background-color=\"#475DA7\" color=\"#ffffff\" font-weight=\"normal\" border-radius=\"4px\" padding=\"0px\" inner-padding=\"10px 20px\" line-height=\"1.5\" target=\"_blank\" vertical-align=\"middle\" border=\"none\" text-align=\"center\" href=\"[[BUTTON_1_URL]]\">\n                                    View Data Access Requests\n                                </mj-button>\n                            </mj-column>\n                        </mj-section>\n\n                    </mj-wrapper>\n                    <!-- body section end -->\n\n                    ",
    "buttons": {
        "replacements": [
            {
                "placeholder": "[[BUTTON_1_URL]]",
                "actual": "config(gateway.gateway_url)/en/account/team/[[TEAM_ID]]/data-access-requests/applications"
            }
        ]
    }
}
