{
    "identifier": "dar.status.changed.researcher",
    "subject": "Status changed for [[PROJECT_TITLE]] from [[CUSTODIAN_NAME]] - Health Data Research Gateway",
    "body": "<mjml>\n                <!-- header start -->\n                <mj-head>\n                    <mj-font name=\"Source Sans 3\" href=\"https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap\" />\n\n                    <mj-html-attributes>\n                        <mj-html-attribute class=\"easy-email\" multiple-attributes=\"false\" attribute-name=\"text-color\" text-color=\"#000000\"></mj-html-attribute>\n                        <mj-html-attribute class=\"easy-email\" multiple-attributes=\"false\" attribute-name=\"font-family\" font-family=\"'Source Sans 3', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif\"></mj-html-attribute>\n                        <mj-html-attribute class=\"easy-email\" multiple-attributes=\"false\" attribute-name=\"font-size\" font-size=\"14px\"></mj-html-attribute>\n                        <mj-html-attribute class=\"easy-email\" multiple-attributes=\"false\" attribute-name=\"line-height\" line-height=\"1.7\"></mj-html-attribute>\n                        <mj-html-attribute class=\"easy-email\" multiple-attributes=\"false\" attribute-name=\"font-weight\" font-weight=\"400\"></mj-html-attribute>\n                        <mj-html-attribute class=\"easy-email\" multiple-attributes=\"false\" attribute-name=\"responsive\" responsive=\"true\"></mj-html-attribute>\n                    </mj-html-attributes>\n\n                    <mj-breakpoint width=\"480px\" />\n                    <mj-attributes>\n                        <mj-all font-family=\"'Source Sans 3', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif\" />\n                        <mj-text font-size=\"14px\" />\n                        <mj-text line-height=\"1.7\" />\n                        <mj-text font-weight=\"400\" />\n                        <mj-text color=\"#000000\" />\n                        <mj-section padding=\"0\" />\n                    </mj-attributes>\n                </mj-head>\n                <!-- header end -->\n\n                <mj-body background-color=\"#eeeeee\" width=\"600px\">\n\n                    <!-- top start -->\n                    <mj-wrapper border=\"none\" direction=\"ltr\" text-align=\"center\" padding=\"10px 0\">\n                        <mj-section direction=\"ltr\" text-align=\"left\" padding=\"0px\" border=\"0px\" background-color=\"#475DA7\">\n                            <mj-column border=\"none\" vertical-align=\"middle\" padding=\"0px\">\n                                <mj-image align=\"left\" width=\"110px\" height=\"50px\" src=\"[[GCS_STORAGE_API_URI]]/[[GCS_BUCKET]]/email/heath_data_research_gateway_logo_white.svg\" alt=\"\"></mj-image>\n                            </mj-column>\n                            <mj-column border=\"none\" vertical-align=\"middle\" padding=\"0px\">\n                                <mj-text color=\"#FFFFFF\" align=\"right\" line-height=\"100%\" font-size=\"20px\" font-weight=\"400\">Data Access Request message</mj-text>\n                            </mj-column>\n                        </mj-section>\n                    </mj-wrapper>\n                    <!-- top end -->\n\n                    <!-- body section start -->\n                    <mj-wrapper background-color=\"#ffffff\" border=\"none\" direction=\"ltr\" text-align=\"center\" padding=\"20px 0\">\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\">\n                                <mj-text padding=\"0px 0px 8px 0px\">Hi [[USER_FIRST_NAME]],</mj-text>\n                                <mj-text padding=\"0px\">The status of your Data Access Request has changed</mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"15px 20px 0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"35%\">\n                                <mj-text padding=\"5px 0px\"><b>Project:</b></mj-text>\n                                <mj-text padding=\"5px 0px\"><b>Dataset:</b></mj-text>\n                                <mj-text padding=\"5px 0px\"><b>Custodian:</b></mj-text>\n                                <mj-text padding=\"5px 0px\"><b>New status:</b></mj-text>\n                            </mj-column>\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"65%\">\n                                <mj-text padding=\"5px 0px\">[[PROJECT_TITLE]]</mj-text>\n                                <mj-text padding=\"5px 0px\">[[DATASET_TITLE]]</mj-text>\n                                <mj-text padding=\"5px 0px\"><a href=\"[[CUSTODIAN_URL]]\" style=\"color:#475DA7;text-decoration:none;\">[[CUSTODIAN_NAME]]</a></mj-text>\n                                <mj-text padding=\"5px 0px\"><span style=\"background-color:#475DA7;color:#ffffff;padding:3px 12px;border-radius:4px;font-size:12px;\">[[DAR_STATUS]]</span></mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"10px 20px 0px 20px\">\n                            <mj-column>\n                                <mj-divider border-color=\"#dee2e6\" border-style=\"dashed\" border-width=\"1px\" padding=\"0\" />\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"10px 20px 0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"35%\">\n                                <mj-text padding=\"0px\"><b>Decision sender</b></mj-text>\n                            </mj-column>\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"65%\">\n                                <mj-text padding=\"0px\">[[DECISION_SENDER_NAME]]</mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"5px 20px 0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"35%\">\n                                <mj-text padding=\"0px\"><b>Comment date:</b></mj-text>\n                            </mj-column>\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\" width=\"65%\">\n                                <mj-text padding=\"0px\">[[COMMENT_DATE]]</mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"10px 20px 0px 20px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\">\n                                <mj-text>[[COMMENT]]</mj-text>\n                            </mj-column>\n                        </mj-section>\n\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"10px 20px 20px 20px\">\n                            <mj-column border=\"1px solid #dee2e6\" border-radius=\"8px\" background-color=\"#f8f9fa\" vertical-align=\"top\" padding=\"20px\">\n                                <mj-text align=\"left\" font-weight=\"700\" font-size=\"14px\" padding=\"0px 0px 10px 0px\">\n                                    View your Data Access Requests on the Gateway, to check the status. You can respond to the message from your Data Access Request within the Gateway.\n                                </mj-text>\n                                <mj-text align=\"left\" font-size=\"13px\" padding=\"0px 0px 15px 0px\">\n                                    Comments, replies and status changes will be sent to this email address.\n                                </mj-text>\n                                <mj-button align=\"left\" background-color=\"#475DA7\" color=\"#ffffff\" font-weight=\"normal\" border-radius=\"4px\" padding=\"0px\" inner-padding=\"10px 20px\" line-height=\"1.5\" target=\"_blank\" vertical-align=\"middle\" border=\"none\" text-align=\"center\" href=\"[[BUTTON_1_URL]]\">\n                                    View Data Access Requests\n                                </mj-button>\n                            </mj-column>\n                        </mj-section>\n\n                    </mj-wrapper>\n                    <!-- body section end -->\n\n                    <!-- separator section start -->\n                    <mj-wrapper border=\"none\" direction=\"ltr\" padding=\"5px 0px\">&nbsp;</mj-wrapper>\n                    <!-- separator end -->\n\n                    <!-- bottom section start -->\n                    <mj-wrapper background-color=\"#ffffff\" border=\"none\" direction=\"ltr\" text-align=\"center\" padding=\"20px\">\n                        <mj-section border=\"none\" direction=\"ltr\" text-align=\"left\" padding=\"0px\">\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px\">\n                                <mj-text align=\"left\" line-height=\"1\" font-size=\"13px\" font-weight=\"400\" padding=\"0px\">\n                                    <b>Make sure you get these emails in future</b>\n                                </mj-text>\n                                <mj-text align=\"left\" line-height=\"1.2\" font-size=\"13px\" font-weight=\"400\" padding=\"10px 0px 0px 0px\">\n                                    To ensure you continue to receive enquiries, responses and all other Gateway notifications, <b>please mark the @healthdatagateway.org domain as 'safe'</b> within your email client. You may also need to speak to your institution to remove any blockers or filters for this address. In the meantime, we suggest checking your junk or spam folders regularly.\n                                </mj-text>\n                            </mj-column>\n                        </mj-section>\n                    </mj-wrapper>\n                    <!-- bottom section end -->\n\n                </mj-body>\n                </mjml>",
    "buttons": {
        "replacements": [
            {
                "placeholder": "[[BUTTON_1_URL]]",
                "actual": "config(gateway.gateway_url)/en/account/data-access-requests"
            }
        ]
    }
}
