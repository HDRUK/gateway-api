{
    "identifier": "user.email_verification",
    "layout": "standard",
    "header_text": "Email Verification",
    "subject": "Verify your email address",
    "body": "\n                        <mj-section background-repeat=\"repeat\" background-size=\"auto\" background-position=\"top center\" border=\"none\" direction=\"ltr\" text-align=\"center\" padding=\"20px 0px 20px 0px\" >\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px 0px 0px 0px\" >\n                                <mj-text align=\"left\" color=\"#3C3C3B\" font-family=\"Museo Sans Rounded,sans-serif\" padding=\"10px 25px 10px 25px\" >Dear [[USER_FIRST_NAME]],<br><br>\n                                      Please verify your email address by clicking the button below. This link will expire in 24 hours.\n                                </mj-text>\n                            </mj-column>\n                        </mj-section>\n                        <mj-section background-repeat=\"repeat\" background-size=\"auto\" background-position=\"top center\" border=\"none\" direction=\"ltr\" text-align=\"center\" padding=\"20px 0px 20px 0px\" >\n                            <mj-column border=\"none\" vertical-align=\"top\" padding=\"0px 0px 0px 0px\" >\n                                <mj-button align=\"center\" background-color=\"#00ACCA\" color=\"#ffffff\" font-weight=\"normal\" border-radius=\"4px\" padding=\"10px 25px 10px 25px\" inner-padding=\"10px 25px 10px 25px\" line-height=\"120%\" target=\"_blank\" vertical-align=\"middle\" border=\"none\" text-align=\"center\" href=\"[[BUTTON_1_URL]]\">Verify Email Address</mj-button>\n                                <mj-text align=\"left\" color=\"#3C3C3B\" font-family=\"Museo Sans Rounded,sans-serif\" padding=\"10px 25px 10px 25px\" ><br><br>\n                                </mj-text>\n                            </mj-column>\n                        </mj-section>\n",
    "buttons": {
        "replacements": [
            {
                "placeholder": "[[BUTTON_1_URL]]",
                "actual": "config(gateway.gateway_url)/en/verification/[[UUID]]"
            }
        ]
    }
}
