flowchart TD
    A(["Incoming HTTP Request\n(api middleware group)"])
    A --> MW

    MW["ResolveGwdmVersionContext\n─────\nhandle(Request \$request, Closure \$next)"]
    MW --> CTX

    CTX["GwdmVersionContext\n─────\ntargetVersion()"]
    CTX --> HDR{x-gwdm-version\nheader present?}

    HDR -- "yes" --> SUP{"GwdmHandlerFactory\n─────\nsupportedVersions()\nin SUPPORTED_VERSIONS\n['2.0','2.1','3.0']?"}
    HDR -- "no" --> CFG

    SUP -- "yes — header is valid" --> RESOLVEDH["(inline)\n─────\nreturn header value\ne.g. '3.0'"]
    SUP -- "no — unrecognised version" --> CFG

    CFG["(inline)\n─────\nConfig::get('metadata.GWDM.version', '2.0')\nfallback to env default"]

    RESOLVEDH --> WRITE
    CFG --> WRITE

    WRITE["ResolveGwdmVersionContext\n─────\nContext::add('gwdm_version', resolvedVersion)"]
    WRITE --> NEXT

    NEXT["(inline)\n─────\n\$next(\$request)\ncontinues middleware chain → controller"]
    NEXT --> PROP

    PROP["Laravel 12 Context\n─────\nauto-propagates 'gwdm_version'\ninto all dispatched jobs\n(LinkageExtraction, TermExtraction, etc.)"]
    PROP --> OK(["Request handling continues\n(jobs carry gwdm_version automatically)"])

    classDef http     fill:#475da7,stroke:#354681,color:#fff
    classDef process  fill:#ffffff,stroke:#29235c,color:#29235c
    classDef mw       fill:#3db28c,stroke:#2a8c6e,color:#fff
    classDef decision fill:#475da7,stroke:#354681,color:#fff
    classDef ok       fill:#3db28c,stroke:#2a8c6e,color:#fff
    classDef err      fill:#f98e2b,stroke:#c96f1a,color:#111
    classDef stub     fill:#6c7cc0,stroke:#475da7,color:#fff

    class A http
    class MW mw
    class CTX,CFG,RESOLVEDH,NEXT,PROP process
    class HDR,SUP decision
    class WRITE mw
    class OK ok
