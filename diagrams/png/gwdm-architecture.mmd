flowchart LR
    %% ── Left: Inbound clients ────────────────────────────────────────────────
    GW_HDRUK(["gateway-web\n[HDRUK]"])
    GMI(["Federated Sources\n[GMI]"])
    GW_CRUK(["gateway-web\n[CRUK]"])
    GW_PRUK(["Custom FE\n[PRUK / others]"])
    EXT(["External\nAPI client"])

    %% ── Centre: Gateway API ──────────────────────────────────────────────────
    subgraph API["Gateway API (Laravel)"]
        direction TB
        META["Metadata Management"]
        AUTH["Auth / SSO"]
        SEARCH["Search"]
        DAR["Data Access Requests"]
        ENTITIES["Entities & Linkages\n(datasets · tools · publications · DURs · collections)"]
        META --- AUTH
        META --- SEARCH
        META --- DAR
        META --- ENTITIES
    end

    %% ── Right: TRASER + linked repos ────────────────────────────────────────
    TRASER["TRASER\n(schema translation service)"]
    MAPPING["traser-mapping-files\n─────────────────────\nHDRUK 4.0 · CRUK 1.1 · PRUK…"]
    SCHEMATA["schemata-2\n─────────────────────\ncanonical schema definitions"]

    %% ── Right bottom: Storage ────────────────────────────────────────────────
    subgraph STORAGE["Storage (MySQL)"]
        direction TB
        DS["datasets\n─────────────────────\npid · team_id · partner_context · status"]
        DV["dataset_versions\n─────────────────────\ngwdm_version · metadata (snapshot)\npatch (RFC 6902 delta)\n─────────────────────\nsnapshot every 10 versions;\ndeltas in between"]
        DS --> DV
    end

    JSON_ENV["JSON envelope"]
    SQL_TABLES["Decomposed SQL\ntables"]

    %% ── Edges: clients → META ────────────────────────────────────────────────
    GW_HDRUK -->|"x-partner-context: HDRUK\nx-gwdm-version: 2.0|2.1|3.0"| META
    GMI      -->|"scheduled pull · create_origin: GMI"| META
    GW_CRUK  -->|"x-partner-context: CRUK\nx-gwdm-version: 2.0|2.1|3.0"| META
    GW_PRUK  -->|"x-partner-context: PRUK\nx-gwdm-version: 2.0|2.1|3.0"| META
    EXT      -->|"x-partner-context: custom"| META

    %% ── Edges: META → TRASER (write: input schema → GWDM) ───────────────────
    META -->|"input schema → GWDM"| TRASER
    TRASER --- MAPPING
    TRASER --- SCHEMATA

    %% ── Invisible rank link: keep TRASER level with Storage ─────────────────
    DS ~~~ TRASER

    %% ── Edges: META → Storage ────────────────────────────────────────────────
    META --> DS

    %% ── Edges: DV → TRASER (read: GWDM → partner schema) ───────────────────
    DV -->|"GWDM → partner schema"| TRASER

    %% ── Edges: DV → storage strategies ──────────────────────────────────────
    DV -->|"GWDM 2.0 / 2.1"| JSON_ENV
    DV -->|"GWDM 3.0"| SQL_TABLES

    %% ── Styles ───────────────────────────────────────────────────────────────
    classDef http     fill:#475da7,stroke:#354681,color:#fff
    classDef cruk     fill:#fc8181,stroke:#e05252,color:#fff
    classDef pruk     fill:#6db1ff,stroke:#4a8fe0,color:#fff
    classDef process  fill:#ffffff,stroke:#29235c,color:#29235c
    classDef metahub  fill:#29235c,stroke:#181560,color:#fff
    classDef mw       fill:#3db28c,stroke:#2a8c6e,color:#fff
    classDef storage  fill:#A2AED3,stroke:#29235c,color:#29235c
    classDef strategy fill:#d0d3d4,stroke:#29235c,color:#29235c

    class GW_HDRUK,EXT,GMI http
    class GW_CRUK cruk
    class GW_PRUK pruk
    class AUTH,SEARCH,DAR,ENTITIES process
    class META metahub
    class TRASER,MAPPING,SCHEMATA mw
    class DS,DV storage
    class JSON_ENV,SQL_TABLES strategy
