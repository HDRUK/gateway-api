flowchart TD
    DISPATCH(["LinkageExtraction::dispatch(datasetId, versionId)"])

    CONSTRUCT["LinkageExtraction\n─────\n__construct(datasetId, datasetVersionId)\nQueue: enrichment · tries: 3 · backoff: 30s"]

    FINDVER["DatasetVersion\n─────\nfindOrFail(datasetVersionId)"]

    GWDM_RES{"gwdm_version\nresolution order"}

    GWDM_COL["inline\n─────\nRead gwdm_version column\n(indexed, reliable on delta rows)"]
    GWDM_JSON["inline\n─────\nRead metadata gwdmVersion key\n(JSON fallback)"]
    GWDM_DEF["inline\n─────\nDefault: '2.0'"]

    EXTRACT["LinkageExtraction\n─────\nExtract linkage arrays from metadata:\ndatasetLinkage\npublicationAboutDataset\npublicationUsingDataset"]

    HANDLE["LinkageExtraction\n─────\nhandle()"]

    MATCH{"match on\ngwdmVersion"}

    GWDM2X["LinkageExtraction\n─────\nhandleGwdm2x()"]
    GWDM30["stub: handleGwdm30()\n─────\nCommented out — pending\nGWDM 3.0 schema finalisation"]
    NOOP(["null — no-op\nversion not handled"])

    DS_LINK["LinkageExtraction\n─────\nprocessDatasetLinkages()"]
    PUB_ABOUT["LinkageExtraction\n─────\nprocessPublicationLinkages\nlinkType = ABOUT"]
    PUB_USING["LinkageExtraction\n─────\nprocessPublicationLinkages\nlinkType = USING"]

    DEL_DS["DatasetVersionHasDatasetVersion\n─────\ndelete where\ndataset_version_source_id = sourceVersionId\ndirect_linkage = 1\ndescription = 'Extracted from GWDM'"]

    DS_NULL{"datasetLinkages\nis null?"}

    DS_LOOP["inline\n─────\nforeach linkage group\nforeach entry in group"]

    FIND_DS["LinkageExtraction\n─────\nfindTargetDataset(entry)\nResolve by: url then pid then title"]

    FIND_DS_FOUND{"target\nversion found?"}

    FOC_DS["DatasetVersionHasDatasetVersion\n─────\nfirstOrCreate\nsource_id, target_id,\nlinkage_type, direct_linkage=1,\ndescription"]

    DS_SKIP(["skip entry\nno dataset match"])

    DEL_PUB["PublicationHasDatasetVersion\n─────\ndelete where\ndataset_version_id = sourceVersionId\ndescription = 'Extracted from GWDM'\nlink_type = linkType"]

    PUB_NULL{"publicationLinkages\nis null?"}

    PUB_LOOP["inline\n─────\nforeach doi\nin publicationLinkages"]

    FIND_PUB["LinkageExtraction\n─────\nfindTargetPublication(doi)\nNormalised DOI match\non Publication table"]

    FIND_PUB_FOUND{"publication\nfound?"}

    FOC_PUB["PublicationHasDatasetVersion\n─────\nwithTrashed firstOrCreate\npublication_id, dataset_version_id,\nlink_type, description"]

    RESTORE{"linkage\nsoft-deleted?"}
    DO_RESTORE["PublicationHasDatasetVersion\n─────\nrestore()"]
    PUB_SKIP(["skip doi\nno publication match"])

    DS_DONE(["Dataset linkages written\ndataset_version_has_dataset_version"])
    PUB_DONE(["Publication linkages written\npublication_has_dataset_version"])

    DISPATCH --> CONSTRUCT
    CONSTRUCT --> FINDVER
    FINDVER --> GWDM_RES

    GWDM_RES -- "column present" --> GWDM_COL
    GWDM_RES -- "column null, JSON key present" --> GWDM_JSON
    GWDM_RES -- "both absent" --> GWDM_DEF

    GWDM_COL --> EXTRACT
    GWDM_JSON --> EXTRACT
    GWDM_DEF --> EXTRACT

    EXTRACT --> HANDLE
    HANDLE --> MATCH

    MATCH -- "2.0 or 2.1" --> GWDM2X
    MATCH -- "3.0 stub" --> GWDM30
    MATCH -- "other" --> NOOP

    GWDM2X --> DS_LINK
    GWDM2X --> PUB_ABOUT
    GWDM2X --> PUB_USING

    DS_LINK --> DEL_DS
    DEL_DS --> DS_NULL
    DS_NULL -- "yes" --> DS_DONE
    DS_NULL -- "no" --> DS_LOOP
    DS_LOOP --> FIND_DS
    FIND_DS --> FIND_DS_FOUND
    FIND_DS_FOUND -- "yes" --> FOC_DS
    FIND_DS_FOUND -- "no" --> DS_SKIP
    FOC_DS --> DS_DONE

    PUB_ABOUT --> DEL_PUB
    PUB_USING --> DEL_PUB
    DEL_PUB --> PUB_NULL
    PUB_NULL -- "yes" --> PUB_DONE
    PUB_NULL -- "no" --> PUB_LOOP
    PUB_LOOP --> FIND_PUB
    FIND_PUB --> FIND_PUB_FOUND
    FIND_PUB_FOUND -- "no" --> PUB_SKIP
    FIND_PUB_FOUND -- "yes" --> FOC_PUB
    FOC_PUB --> RESTORE
    RESTORE -- "yes" --> DO_RESTORE
    RESTORE -- "no" --> PUB_DONE
    DO_RESTORE --> PUB_DONE

    classDef http     fill:#475da7,stroke:#354681,color:#fff
    classDef process  fill:#ffffff,stroke:#29235c,color:#29235c
    classDef mw       fill:#3db28c,stroke:#2a8c6e,color:#fff
    classDef decision fill:#475da7,stroke:#354681,color:#fff
    classDef ok       fill:#3db28c,stroke:#2a8c6e,color:#fff
    classDef err      fill:#f98e2b,stroke:#c96f1a,color:#111
    classDef stub     fill:#6c7cc0,stroke:#475da7,color:#fff

    class DISPATCH http
    class CONSTRUCT,FINDVER,EXTRACT,HANDLE,GWDM2X,DS_LINK,PUB_ABOUT,PUB_USING,DEL_DS,DS_LOOP,FIND_DS,FOC_DS,DEL_PUB,PUB_LOOP,FIND_PUB,FOC_PUB,DO_RESTORE,GWDM_COL,GWDM_JSON,GWDM_DEF process
    class GWDM_RES,MATCH,DS_NULL,FIND_DS_FOUND,PUB_NULL,FIND_PUB_FOUND,RESTORE decision
    class DS_DONE,PUB_DONE ok
    class NOOP,DS_SKIP,PUB_SKIP err
    class GWDM30 stub
